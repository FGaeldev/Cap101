anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PanelContainer" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2

[node name="BoxContainer" type="BoxContainer" parent="CenterContainer/PanelContainer"]
layout_mode = 2

